{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "GTH",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true,
        "execute": true,
        "sidecar": true,
        "scope": [
          {
            "name": "gth-backend",
            "cmd": "./gth-backend",
            "args": true
          }
        ]
      },
      "process": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": ["$APP/*", "$HOME/*"]
      },
      "path": {
        "all": true
      },
      "http": {
        "all": true,
        "scope": ["http://localhost:*", "http://127.0.0.1:*", "https://*"]
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": ["gth-backend"],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.gth.app",
      "longDescription": "Git Helper Tool - Analise repositórios e crie bases de conhecimento com IA",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "GTH - Git Helper Tool",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "GTH - Git Helper Tool",
        "width": 1200,
        "center": true,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  }
}

